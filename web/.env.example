# Supabase (Phase 2) — copy to web/.env.local and fill in from the Supabase dashboard.
# Never commit .env.local. Never put service_role in VITE_* variables.

# Project URL (Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable / anon key only (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: set to "true" to show team sign-in UI even during local dev
# VITE_SUPABASE_AUTH_ENABLED=true

# --- RLS test script (web/.env.local only; NOT loaded by Vite) ---
# SUPABASE_URL and SUPABASE_ANON_KEY default from VITE_* when omitted.
TEAM_USER_A_EMAIL=teammate-a@example.com
TEAM_USER_A_PASSWORD=
TEAM_USER_B_EMAIL=teammate-b@example.com
TEAM_USER_B_PASSWORD=
